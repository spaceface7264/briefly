{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "briefly",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "briefly"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://bncuqifjcsrjkohxkwez.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_kiij5LwoTAVQoom57SUGXQ_rgtClNuy",
    "NEXT_PUBLIC_APP_URL": "http://localhost:3001"
  },
  "env": {
    "staging": {
      "name": "briefly-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "briefly-staging"
        }
      ]
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "boulders-creators",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "boulders-creators"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://hfepjqlbwcwhppbxxpkr.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhmZXBqcWxid2N3aHBwYnh4cGtyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY3OTEyNTcsImV4cCI6MjA5MjM2NzI1N30.IMtFmTWaZC3rQgr9n2OjomvZhmS_FBMzksfKbldJ8nw"
  },
  "env": {
    "staging": {
      "name": "boulders-creators-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "boulders-creators-staging"
        }
      ]
    }
  }
}

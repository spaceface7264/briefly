{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rainbow",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Ensure the OpenNext build runs before any wrangler-driven deploy
  // (e.g. Cloudflare Workers Build) so `.open-next/` exists. Skipped when
  // wrangler is invoked recursively by `opennextjs-cloudflare deploy`,
  // which sets OPEN_NEXT_DEPLOY=true to break the loop.
  "build": {
    "command": "node -e \"if(!process.env.OPEN_NEXT_DEPLOY){require('child_process').execSync('npx opennextjs-cloudflare build',{stdio:'inherit'})}\""
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rainbow"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://bncuqifjcsrjkohxkwez.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_kiij5LwoTAVQoom57SUGXQ_rgtClNuy",
    "NEXT_PUBLIC_APP_URL": "https://app.briefly.dk"
  },
  "routes": [
    {
      "pattern": "app.briefly.dk",
      "zone_name": "briefly.dk",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "rainbow-staging",
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://bncuqifjcsrjkohxkwez.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_kiij5LwoTAVQoom57SUGXQ_rgtClNuy",
        "NEXT_PUBLIC_APP_URL": "https://rainbow-staging.ramieldaoud.workers.dev"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "rainbow-staging"
        }
      ]
    },
    "preview": {
      "name": "rainbow-preview",
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://bncuqifjcsrjkohxkwez.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_kiij5LwoTAVQoom57SUGXQ_rgtClNuy",
        "NEXT_PUBLIC_APP_URL": "https://rainbow-preview.ramieldaoud.workers.dev"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "rainbow-preview"
        }
      ]
    }
  }
}

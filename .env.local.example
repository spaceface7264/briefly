# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Connect)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL used for Stripe onboarding return/refresh links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform branding (public — exposed to the browser)
NEXT_PUBLIC_PLATFORM_NAME=Briefly
NEXT_PUBLIC_LOGO_URL=https://example.com/logo.png
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Platform legal entity (appears as "customer" on self-billed invoices)
PLATFORM_ADDRESS=123 Main St\n1000 City
PLATFORM_CVR=12345678
PLATFORM_VAT_NUMBER=DK12345678

# Email notifications (Supabase Edge Functions)
PLATFORM_SENDER_NAME=Briefly
PLATFORM_SENDER_EMAIL=notifications@example.com

# Dedicated bearer for invoking edge functions from the app (e.g. createOrg ->
# notify-org-invite). Must match the FUNCTIONS_INVOKE_SECRET set in the
# Supabase function secrets.
FUNCTIONS_INVOKE_SECRET=your-functions-invoke-secret
